{
  "systemName": "spectra-autonomous-core",
  "logging": {
    "level": "debug",
    "traceStateDiffs": true,
    "traceGuards": true,
    "jsonlFilePath": ".spectra/logs/session.jsonl"
  },
  "database": {
    "connectionString": "postgres://spectra:spectra_pass@localhost:5432/spectra_db",
    "embeddingDimension": 384
  },
  "embeddings": {
    "provider": "transformers.js",
    "modelName": "Xenova/multilingual-e5-small",
    "cacheDir": "./.spectra/models",
    "modalityWeights": [
      0.5,
      0.3,
      0.2
    ]
  },
  "system1": {
    "provider": "@receptron/laya",
    "cacheDir": "./.spectra/laya-cache",
    "temperaturePlatt": 1,
    "maxDrift": 0.65,
    "minCoherence": 0.35,
    "minApproveProb": 0.4
  },
  "system2": {
    "provider": "openai",
    "apiKey": "",
    "baseUrl": "http://localhost:20128/v1",
    "frontierModel": "cheaperinference/deepseek-v4.1-flash",
    "lightModel": "cheaperinference/deepseek-v4.1-flash"
  },
  "runtime": {
    "hardStepLimit": 50,
    "stateHashLoopThreshold": 2,
    "pprTeleportAlpha": 0.15
  }
}